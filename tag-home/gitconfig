[help]
	browser = firefox
[merge]
	tool = nvimdiff
	guitool = nvimdiff
[mergetool "nvimdiff"]
  cmd = nvim -d "$MERGED" "$LOCAL" "$BASE" "$REMOTE" -c 'wincmd J' 
[diff]
	tool = nvimdiff
	guitool = nvimdiff
[difftool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$REMOTE"
[commit]
	gpgsign = false
